generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model PlaceType {
  id   String @id
  name String @unique
}

model Place {
  id        String   @id
  name      String
  typeId    String?
  lat       Float?
  lng       Float?
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  // PlaceMap inteiro do app (blocos, células, planta, samples)
  map       Json?
  userId    String?
}

// Uma leitura completa feita pelo aparelho. Sem FK com Place (ids gerados no cliente).
model Scan {
  id           String        @id @default(cuid())
  userId       String?
  deviceId     String?
  platform     String?
  kind         String // sample | locate | debug
  placeId      String?
  placeName    String?
  blockId      String?
  blockName    String?
  lat          Float?
  lng          Float?
  accuracy     Float?
  heading      Float?
  startedAt    DateTime?
  createdAt    DateTime      @default(now())
  wifiCount    Int
  bleCount     Int
  matchName    String?
  matchDist    Float?
  matchCommon  Int?
  matchSource  String?
  matchSure    Boolean?
  note         String?
  raw          Json
  readings     ScanReading[]

  @@index([createdAt])
  @@index([placeId])
  @@index([blockId])
  @@index([deviceId])
  @@index([userId])
}

model ScanReading {
  id        String  @id @default(cuid())
  scanId    String
  scan      Scan    @relation(fields: [scanId], references: [id], onDelete: Cascade)
  kind      String // wifi | ble
  bssid     String
  ssid      String?
  rssi      Int
  frequency Int?
  kept      Boolean

  @@index([bssid])
  @@index([scanId])
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique // sempre em minúsculas
  passwordHash String
  role         String   @default("collector") // admin | collector
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
