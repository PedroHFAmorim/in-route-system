# Postgres (na Railway: ${{Postgres.DATABASE_URL}}; local: proxy TCP público, ver INFRA.md)
DATABASE_URL=postgresql://usuario:senha@host:5432/banco
PORT=3000
# Obrigatória: a API não sobe sem ela. Gere com: openssl rand -hex 32
JWT_SECRET=
# Primeiro admin (criado no boot se ainda não existir; senha com no mínimo 8 caracteres)
ADMIN_EMAIL=
ADMIN_PASSWORD=
